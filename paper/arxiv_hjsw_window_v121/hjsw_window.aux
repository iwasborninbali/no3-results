\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces $p=11$, $c=1$: exact maximum lawful subset of $H(1,11)$ in the box $[x_0,x_0+22)\times [y_0,y_0+22)$, indexed by $x_0+h\bmod  p$ (rows; $0$ is the HJSW position $x_0=-h$) and $y_0\bmod  p$ (columns). Values (HiGHS MIP, witnesses through the law; they agree with the formula of Theorem~\ref {thm:window}) range from $2(p-1)+2s=22$ to $3(p-1)=30$; the double-count bound $Z+2|\mathcal  {L}|$ equals $30$ for $76$ boxes but is attained for $20$ (the others have a $(1,1)$-orbit).}}{12}{table.1}\protected@file@percent }
